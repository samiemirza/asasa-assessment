# Neon Postgres. The app uses the pooled endpoint; migrations use the direct one.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=verify-full
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=verify-full

# Pricing engine (all optional, defaults shown)
PRICE_REFRESH_SECONDS=300
PRICE_STALE_CAP_SECONDS=900
BUY_MARKUP=1.10
SELL_MARKDOWN=0.90
